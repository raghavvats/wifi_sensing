# Copy to configs/sensing.env and edit as needed.
# Source on the Pi:  set -a && source configs/sensing.env && set +a

# Wi-Fi AP (Pi)
WIFI_SSID=wifi-sensing
WIFI_PSK=wifisense123
WIFI_CHANNEL=6
WIFI_IFACE=wlan0
AP_IP=192.168.4.1
AP_NETMASK=255.255.255.0
DHCP_RANGE_START=192.168.4.10
DHCP_RANGE_END=192.168.4.50

# UDP ports
PROBE_PORT=5005
CSI_PORT=5006

# Probe sender
PROBE_RATE_HZ=30
PROBE_SETTLE_S=2.0

# ESP32 node (must match firmware sdkconfig / Kconfig)
# NODE_ID is set per board at build time (CONFIG_CSI_NODE_ID)
