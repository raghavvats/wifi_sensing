# Copy to configs/sensing.env and edit as needed.
# Source on the Pi:  set -a && source configs/sensing.env && set +a

# Wi-Fi AP (Pi)
WIFI_SSID=wifi-sensing
WIFI_PSK=wifisense123
WIFI_CHANNEL=6
WIFI_IFACE=wlan0
AP_IP=192.168.4.1
AP_NETMASK=255.255.255.0
DHCP_RANGE_START=192.168.4.10
DHCP_RANGE_END=192.168.4.50

# UDP ports
PROBE_PORT=5005
CSI_PORT=5006
MESH_CONTROL_PORT=5007
MESH_HELLO_PORT=5008

# Star-topology probe sender (pi/probe/send_probes.py)
PROBE_RATE_HZ=30
PROBE_SETTLE_S=1.0

# Mesh TDMA orchestrator (pi/orchestrator/run_mesh.py)
# Probe: enough time for CSI callback on weaker links.
# Report: last reporter must finish CSI2 flush before next cycle clears the buffer.
MESH_PROBE_SLOT_MS=20
MESH_REPORT_SLOT_MS=40
MESH_CYCLES=0
MESH_HELLO_WAIT_S=8
MESH_EXPECT_PEERS=3

# ESP32 node (must match firmware sdkconfig / Kconfig)
# NODE_ID is set per board at build time (CONFIG_CSI_NODE_ID)
