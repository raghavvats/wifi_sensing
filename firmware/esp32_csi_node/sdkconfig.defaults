# Target: classic ESP32
CONFIG_IDF_TARGET_ESP32=y

# Wi-Fi CSI
CONFIG_ESP_WIFI_CSI_ENABLED=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Project defaults (can override in menuconfig)
CONFIG_CSI_WIFI_SSID="wifi-sensing"
CONFIG_CSI_WIFI_PASSWORD="wifisense123"
CONFIG_CSI_NODE_ID=1
CONFIG_CSI_COLLECTOR_IP="192.168.4.1"
CONFIG_CSI_COLLECTOR_PORT=5006
CONFIG_CSI_PROBE_PORT=5005
CONFIG_CSI_MAX_RATE_HZ=80
CONFIG_CSI_FILTER_BSSID=y
